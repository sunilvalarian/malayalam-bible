rules_version = '2';

// Malayalam Bible — who may do what.
//   anyone (no login)  : read the text (bundled text + shared edits)
//   reader             : + keep their own highlights / bookmarks / notes in the cloud
//   editor             : + edit chapters, upload PDFs, restore original text
//   admin              : + delete chapters, reset all edits, manage users, roles and invites, see activity
//   none (blocked)     : signed in, but no rights beyond an anonymous visitor (set by an admin)
// An admin can also open "upload PDFs" / "edit chapters" to every signed-in, non-blocked user
// (settings/permissions), and hand out one-time access codes that grant editor / admin (accessCodes).
// The owner e-mail below is always admin (once its e-mail address is verified).
// Keep this list in sync with APP_OWNERS in app/js/firebase-config.js.

service cloud.firestore {
  match /databases/{database}/documents {

    function owners() { return ['sunilvalarian@gmail.com']; }
    // Preset editors (APP_EDITORS in firebase-config.js) start as editor on their first sign-in,
    // like a standing invite; after that an admin can change their role and it sticks.
    function presetEditors() { return ['haiabel43@gmail.com']; }
    function roles() { return ['reader', 'editor', 'admin']; }
    function allRoles() { return ['none', 'reader', 'editor', 'admin']; }       // 'none' = blocked
    function providers() { return ['google.com', 'github.com', 'microsoft.com', 'emailLink', 'password', 'passkey']; }

    function signedIn() { return request.auth != null; }
    // '' for an account without an e-mail (e.g. GitHub / Microsoft with a hidden address), so its profile can still be made
    function myEmail() { return request.auth.token.get('email', '').lower(); }
    function verified() { return signedIn() && request.auth.token.email_verified == true; }
    function isOwner() { return verified() && myEmail() in owners(); }
    function userPath() { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function myRole() {
      return signedIn() && exists(userPath()) ? get(userPath()).data.role : 'none';
    }
    // a signed-in user who has a profile and is not blocked
    function active() { return isOwner() || myRole() in roles(); }
    function isAdmin() { return isOwner() || myRole() == 'admin'; }
    function isEditor() { return isAdmin() || myRole() == 'editor'; }
    function invitePath() { return /databases/$(database)/documents/invites/$(myEmail()); }
    function invitedAs(role) {
      return verified() && exists(invitePath()) && get(invitePath()).data.role == role;
    }
    function rank(r) { return { 'none': 0, 'reader': 1, 'editor': 2, 'admin': 3 }.get(r, 0); }

    // Admin switches (settings/permissions): openUpload / openEdit = true opens PDF upload /
    // chapter editing to every signed-in user who isn't blocked.
    function settingsPath() { return /databases/$(database)/documents/settings/permissions; }
    function opened(key) {
      return exists(settingsPath()) && get(settingsPath()).data.get(key, false) == true;
    }

    // Access codes (id = the code: 8–16 of A–Z / 2–9 without the look-alikes 0 O 1 I L)
    function codeIdOk(c) { return c is string && c.matches('^[ABCDEFGHJKMNPQRSTUVWXYZ23456789]{8,16}$'); }
    function codePath(c) { return /databases/$(database)/documents/accessCodes/$(c); }
    // Redeeming code c moves this user from oldRole to newRole: BEFORE this request the code must be
    // unused, not revoked and not expired, and grant exactly newRole — a promotion (never the same or a
    // lower role, never for a blocked user); and the same batch must mark it used by this user.
    function codeGrants(c, oldRole, newRole) {
      return codeIdOk(c) && exists(codePath(c))
        && get(codePath(c)).data.used == false
        && get(codePath(c)).data.revoked == false
        && get(codePath(c)).data.expiresAt > request.time
        && get(codePath(c)).data.role == newRole
        && oldRole in ['reader', 'editor'] && rank(newRole) > rank(oldRole)
        // an unverified account that uses the owner's address must not get a role that ownerProfile() protects
        && !(myEmail() in owners() && !verified())
        && getAfter(codePath(c)).data.used == true
        && getAfter(codePath(c)).data.usedBy == request.auth.uid;
    }

    // Chapters bundled with the app (app/js/data.js). hasBase must match this, so an editor
    // can't mark an uploaded chapter as "bundled" to get delete rights. Update when data.js
    // gains books (e.g. `|| (b == 'EXO' && c >= 1 && c <= 40)`).
    function isBundled(b, c) {
      return (b == 'GEN' && c >= 1 && c <= 50)
        || (b == 'EXO' && c >= 1 && c <= 3)
        || (b == 'MAT' && c >= 1 && c <= 28)
        || (b == 'MRK' && c >= 1 && c <= 16)
        || (b == 'LUK' && c >= 1 && c <= 24)
        || (b == 'ACT' && c >= 1 && c <= 28)
        || (b == 'ROM' && c >= 1 && c <= 16)
        || (b == '1CO' && c >= 1 && c <= 16)
        || (b == '2CO' && c >= 1 && c <= 13)
        || (b == 'GAL' && c >= 1 && c <= 6)
        || (b == 'EPH' && c >= 1 && c <= 6)
        || (b == 'PHP' && c >= 1 && c <= 4)
        || (b == 'COL' && c >= 1 && c <= 4);
    }

    // ---- shared chapter edits / uploads (id = BOOK_CHAPTER, e.g. GEN_3) ----
    match /chapters/{id} {
      allow read: if true;

      function validChapter() {
        let d = request.resource.data;
        return d.keys().hasOnly(['book', 'chapter', 'items', 'deleted', 'bookName', 'hasBase', 'updatedAt', 'updatedBy'])
          && d.book is string && d.book.size() > 0 && d.book.size() <= 20
          && d.chapter is int && d.chapter > 0 && d.chapter <= 200
          && id == d.book + '_' + string(d.chapter)
          && d.items is list && d.items.size() <= 3000
          && d.deleted is bool
          // a chapter must have content unless it is being hidden (admin-only, below)
          && (d.deleted == true || d.items.size() > 0)
          && d.hasBase == isBundled(d.book, d.chapter)
          && (d.bookName == null || (d.bookName is string && d.bookName.size() <= 60))
          && d.updatedBy == myEmail()
          && d.updatedAt == request.time;
      }

      // editors write content; hiding a chapter (deleted = true) is admin-only.
      // When an admin has opened it (settings/permissions), any signed-in user who isn't blocked may too:
      //   openUpload: add or overwrite any chapter (what a PDF upload does);
      //   openEdit:   change an existing, visible chapter, or create the override of a bundled one.
      // A chapter an admin has hidden (deleted = true) stays hidden for them.
      allow create: if validChapter()
        && (request.resource.data.deleted == false || isAdmin())
        && (isEditor()
            || (active() && (opened('openUpload')
                             || (opened('openEdit') && request.resource.data.hasBase == true))));
      allow update: if validChapter()
        && (request.resource.data.deleted == false || isAdmin())
        && (isEditor()
            || (active() && resource.data.deleted == false
                && (opened('openUpload') || opened('openEdit'))));
      // removing an override: editors may only "restore original" of a bundled chapter;
      // removing an uploaded chapter entirely is admin-only (neither is ever opened to everyone)
      allow delete: if isAdmin() || (isEditor() && resource.data.hasBase == true);
    }

    // ---- user profiles + roles ----
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());

      function profileOk() {
        let d = request.resource.data;
        return d.keys().hasOnly(['email', 'name', 'role', 'provider', 'createdAt', 'lastLogin', 'presetApplied', 'redeemedCode'])
          && d.email == myEmail() && d.role in allRoles()
          && d.name is string && d.name.size() <= 100
          && (!('provider' in d) || d.provider in providers())
          && (!('presetApplied' in d) || d.presetApplied == true)
          && (!('redeemedCode' in d) || codeIdOk(d.redeemedCode));
      }
      function sameCode() {
        return request.resource.data.get('redeemedCode', null) == resource.data.get('redeemedCode', null);
      }
      // Redeeming an access code: only role + redeemedCode change, and the code is consumed in the same
      // batched write (codeGrants). No e-mail verification needed. A used code can never be used again,
      // so an old redeemedCode can't promote anyone again after an admin's demotion.
      function redeeming() {
        let d = request.resource.data;
        return !sameCode()
          && d.diff(resource.data).affectedKeys().hasOnly(['role', 'redeemedCode'])
          && codeGrants(d.get('redeemedCode', ''), resource.data.role, d.role);
      }
      // first sign-in: start as reader, or as the role an admin invited this e-mail for
      allow create: if signedIn() && request.auth.uid == uid && profileOk()
        && request.resource.data.role in roles()
        && request.resource.data.createdAt == request.time
        && request.resource.data.lastLogin == request.time
        && !('redeemedCode' in request.resource.data)
        && (request.resource.data.role == 'reader'
            || (request.resource.data.role == 'admin' && isOwner())
            // presetApplied marks the preset as used, so a later demotion by an admin sticks
            || (request.resource.data.role == 'editor' && verified() && myEmail() in presetEditors()
                && request.resource.data.get('presetApplied', false) == true)
            || invitedAs(request.resource.data.role));

      // the user may update their own name / last login / sign-in method, and take up an invite
      // (a blocked user stays 'none' unless an admin sends them a new invite).
      // A preset editor whose profile was made before the e-mail was verified becomes editor once,
      // on the first verified sign-in (presetApplied marks it used, so a later demotion sticks).
      // Or redeem an access code (redeeming(), above) — the only way redeemedCode can change.
      allow update: if signedIn() && request.auth.uid == uid && profileOk()
        && request.resource.data.createdAt == resource.data.createdAt
        && (request.resource.data.lastLogin == request.time || request.resource.data.lastLogin == resource.data.lastLogin)
        && (!('presetApplied' in resource.data) || request.resource.data.get('presetApplied', false) == true)
        && ((sameCode()
             && (request.resource.data.role == resource.data.role
                 || (request.resource.data.role in roles() && invitedAs(request.resource.data.role))
                 || (request.resource.data.role == 'admin' && isOwner())
                 || (request.resource.data.role == 'editor' && resource.data.role == 'reader'
                     && verified() && myEmail() in presetEditors()
                     && !('presetApplied' in resource.data) && request.resource.data.get('presetApplied', false) == true)))
            || redeeming());

      // admins change roles or block a user (role 'none'); an owner can never be demoted,
      // and an admin can't change their own role. The owner's profile is protected once it is
      // admin (the app makes it admin after the e-mail is verified), so an unverified account that
      // merely claims the owner's address stays a reader that admins can block or remove.
      function ownerProfile() {
        return resource.data.email in owners() && resource.data.role == 'admin' && !('redeemedCode' in resource.data);
      }
      allow update: if isAdmin() && request.auth.uid != uid
        && request.resource.data.role in allRoles()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role'])
        && !ownerProfile();
      allow delete: if isAdmin() && request.auth.uid != uid && !ownerProfile();
    }

    // ---- invitations: admin pre-assigns a role to an e-mail (id = lower-case e-mail) ----
    match /invites/{email} {
      allow read: if isAdmin() || (verified() && email == myEmail());
      allow create, update: if isAdmin()
        && email == email.lower()
        && request.resource.data.keys().hasOnly(['role', 'by', 'at'])
        && request.resource.data.role in ['editor', 'admin']
        && request.resource.data.by == myEmail();
      // the invited person removes it once claimed, so it can't re-apply after a demotion
      allow delete: if isAdmin() || (verified() && email == myEmail());
    }

    // ---- access codes: an admin makes a one-time code that grants editor / admin ----
    // id = the code itself (unguessable, ~40 bits). Redeeming is ONE batched write by the user:
    //   users/{uid}        role := code role, redeemedCode := code    (users rule → codeGrants)
    //   accessCodes/{code} used := true, usedBy := uid, usedAt := now  (rule below)
    // Each half checks the other with getAfter(), so neither can be written on its own.
    match /accessCodes/{code} {
      // only admins list codes; a signed-in user may look up one code whose id they already know
      // (so the app can say "used" / "expired" / "revoked")
      allow get: if signedIn();
      allow list: if isAdmin();
      allow create: if isAdmin() && codeIdOk(code)
        && request.resource.data.keys().hasOnly(['role', 'note', 'createdBy', 'createdAt', 'expiresAt', 'used', 'usedBy', 'usedAt', 'revoked'])
        && request.resource.data.keys().hasAll(['role', 'note', 'createdBy', 'createdAt', 'expiresAt', 'used', 'usedBy', 'usedAt', 'revoked'])
        && request.resource.data.role in ['editor', 'admin']
        && request.resource.data.note is string && request.resource.data.note.size() <= 100
        && request.resource.data.createdBy == myEmail()
        && request.resource.data.createdAt == request.time
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <= request.time + duration.value(31, 'd')
        && request.resource.data.used == false && request.resource.data.usedBy == null
        && request.resource.data.usedAt == null && request.resource.data.revoked == false;
      // an admin revokes a code (nothing else about it changes)
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['revoked'])
        && request.resource.data.revoked == true;
      // the redeeming user marks it used, in the same batch that gives them the code's role
      allow update: if signedIn()
        && resource.data.used == false && resource.data.revoked == false
        && resource.data.expiresAt > request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['used', 'usedBy', 'usedAt'])
        && request.resource.data.used == true
        && request.resource.data.usedBy == request.auth.uid
        && request.resource.data.usedAt == request.time
        && myRole() in ['reader', 'editor'] && rank(resource.data.role) > rank(myRole())
        && getAfter(userPath()).data.get('redeemedCode', '') == code
        && getAfter(userPath()).data.role == resource.data.role;
      allow delete: if false;
    }

    // ---- site settings (public): the admin switches that open upload / editing to everyone ----
    match /settings/{id} {
      allow read: if true;
      allow create, update: if isAdmin() && id == 'permissions'
        && request.resource.data.keys().hasOnly(['openUpload', 'openEdit', 'updatedBy', 'updatedAt'])
        && request.resource.data.keys().hasAll(['openUpload', 'openEdit', 'updatedBy', 'updatedAt'])
        && request.resource.data.openUpload is bool && request.resource.data.openEdit is bool
        && request.resource.data.updatedBy == myEmail()
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    // ---- personal highlights / bookmarks / notes (not for blocked users) ----
    match /userdata/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid && active();
    }

    // ---- passkeys (id = WebAuthn credential id, base64url) ----
    // A signed-in user registers a public key for their own account. Signing in with it is
    // verified by the Cloudflare Pages Function (functions/api/passkey/verify.js), which uses a
    // service account (not bound by these rules) to update counter / lastUsedAt.
    match /passkeys/{id} {
      allow read, delete: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      // only with a verified e-mail: a passkey added by someone who merely registered the address first
      // would outlive the real owner taking the account over (same uid)
      allow create: if verified() && active()
        && id.size() >= 16 && id.size() <= 700 && id.matches('^[A-Za-z0-9_-]+$')
        && request.resource.data.keys().hasOnly(['uid', 'publicKey', 'alg', 'counter', 'name', 'transports', 'createdAt', 'lastUsedAt'])
        && request.resource.data.keys().hasAll(['uid', 'publicKey', 'alg', 'counter', 'name', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.publicKey is string
        && request.resource.data.publicKey.size() > 40 && request.resource.data.publicKey.size() <= 2000
        && request.resource.data.alg in [-7, -257]
        && request.resource.data.counter == 0
        && request.resource.data.name is string && request.resource.data.name.size() <= 60
        && (!('transports' in request.resource.data)
            || (request.resource.data.transports is list && request.resource.data.transports.size() <= 10))
        && request.resource.data.createdAt == request.time
        && (!('lastUsedAt' in request.resource.data) || request.resource.data.lastUsedAt == null);
      allow update: if false;
    }

    // used passkey challenges (replay protection) — written by the server function only
    match /passkeyChallenges/{id} {
      allow read, write: if false;
    }

    // ---- activity log ----
    // (while editing / upload is open to everyone, readers' edits are logged too)
    match /changes/{id} {
      allow read: if isAdmin();
      allow create: if (isEditor()
          || (active() && request.resource.data.action in ['edit', 'edit-verse', 'upload']
              && (opened('openEdit') || opened('openUpload'))))
        && request.resource.data.keys().hasOnly(['action', 'book', 'chapter', 'by', 'at', 'detail'])
        && (!('detail' in request.resource.data)
            || (request.resource.data.detail is string && request.resource.data.detail.size() <= 200))
        && request.resource.data.by == myEmail()
        && request.resource.data.at == request.time;
    }

    // ---- usage log (app/js/usage.js) ----
    // Every device, also visitors who aren't signed in, uploads what was done in the app (chapters
    // read, searches, copies, logins, …) in batches of at most 200 events, including the ones
    // recorded offline. A batch names the account that uploads it (checked here), or none for a
    // visitor. The device picks the id, so create-only: a batch that is sent twice is stored once.
    // Only admins can read the log or delete old batches.
    function usageOk(d) {
      return d.keys().hasOnly(['v', 'device', 'uid', 'email', 'name', 'dev', 'geo', 'events', 'n', 'from', 'to', 'at'])
        && d.keys().hasAll(['v', 'device', 'uid', 'email', 'events', 'n', 'from', 'to', 'at'])
        && d.v == 1
        && d.device is string && d.device.matches('^[A-Za-z0-9]{16,32}$')
        && (signedIn()
            ? d.uid == request.auth.uid && d.email == request.auth.token.get('email', '').lower()
            : d.uid == null && d.email == null)
        && (!('name' in d) || d.name == null || (d.name is string && d.name.size() <= 100))
        && (!('dev' in d) || (d.dev is map && d.dev.size() <= 20))
        && (!('geo' in d) || d.geo == null || (d.geo is map && d.geo.size() <= 8))
        && d.events is list && d.events.size() >= 1 && d.events.size() <= 200
        && d.n == d.events.size()
        && d.from is int && d.to is int && d.from <= d.to
        && d.at == request.time;
    }
    match /usage/{id} {
      allow read, delete: if isAdmin();
      allow create: if id.matches('^[A-Za-z0-9]{20}$') && usageOk(request.resource.data);
    }
  }
}
